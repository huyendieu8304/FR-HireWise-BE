# ============================================================
# TEMPLATE - copy file nay thanh .env.local / .env.dev / .env.prod
# roi dien gia tri that. File .env.example duoc phep len git (khong
# chua secret), 3 file con lai bi .gitignore chan tuyet doi.
#
# application.properties se tu dong nap dung file .env theo profile
# dang active (xem spring.config.activate.on-profile trong file do):
#   profile "local" -> .env.local
#   profile "dev"    -> .env.dev
#   profile "prod"   -> .env.prod
# ============================================================

# --- Database (Supabase Postgres, schema "public" - business data) ---
# Dung Session pooler hoac Direct connection (port 5432), KHONG dung
# Transaction pooler (thuong port 6543).
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=changeme

# --- Keycloak / OAuth2 Resource Server ---
KEYCLOAK_ISSUER_URI=http://localhost:8081/realms/hirewise
KEYCLOAK_RESOURCE_CLIENT_ID=hirewise-be

# --- Log level ---
# root: log cua framework/thu vien ben thu 3. app: log cua package
# com.hirewise.be (code cua chinh minh) - thuong de DEBUG o local,
# INFO o dev/prod de khong qua nhieu.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# --- OpenTelemetry (trace) ---
# De trong = tat han (khong export, khong log loi ket noi) vi chua co
# OTel Collector. Khi da trien khai Collector, dien endpoint dang:
#   http://<otel-collector-host>:4318   (OTLP/HTTP)
# roi tang TRACING_SAMPLING_PROBABILITY len > 0.
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACING_SAMPLING_PROBABILITY=0
