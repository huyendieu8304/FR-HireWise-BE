# ============================================================
# TEMPLATE - copy file nay thanh .env.local / .env.dev / .env.prod
# roi dien gia tri that. File .env.example duoc phep len git (khong
# chua secret), 3 file con lai bi .gitignore chan tuyet doi.
#
# application.properties se tu dong nap dung file .env theo profile
# dang active (xem spring.config.activate.on-profile trong file do):
#   profile "local" -> .env.local
#   profile "dev"    -> .env.dev
#   profile "prod"   -> .env.prod
# ============================================================

# --- Database (Supabase Postgres, schema "public" - business AND auth data) ---
# Dung Session pooler hoac Direct connection (port 5432), KHONG dung
# Transaction pooler (thuong port 6543).
DB_URL=jdbc:postgresql://<supabase-host>:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=changeme

# --- JWT  ---
# Base64 cua >= 32 byte ngau nhien, vd tao bang: openssl rand -base64 32
# PHAI dat gia tri co dinh cho dev/prod - de trong o local se tu sinh key
# ngau nhien moi lan restart (chi phu hop de code tren may ca nhan).
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=28800

# --- khoa tai khoan sau nhieu lan dang nhap sai ---
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_WINDOW_MINUTES=15
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=7
AUTH_IP_RATE_LIMIT_MAX_ATTEMPTS=20
AUTH_IP_RATE_LIMIT_WINDOW_MINUTES=15

# --- Google SSO (OAuth Client ID tu Google Cloud Console).
# De trong = tat Google SSO.
GOOGLE_CLIENT_ID=

# --- CORS: origin cua frontend duoc phep goi API nay tu browser.
# Nhieu origin cach nhau boi dau phay.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- link kich hoat tai khoan ---
ACTIVATION_TOKEN_TTL_HOURS=72
ACTIVATION_LINK_BASE_URL=http://localhost:5173/activate

# --- Bootstrap HR_ADMIN dau tien (xem config.BootstrapAdminInitializer) ---
# Chi chay 1 lan (khi chua co user nao voi email nay). Nen bo trong sau khi
# da dang nhap thanh cong lan dau, dac biet o prod.
BOOTSTRAP_ADMIN_EMAIL=hradmin@hirewise.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FULL_NAME=Bootstrap HR Admin

# --- SMTP (gui email EM-01 / canh bao khoa tai khoan qua outbox) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@hirewise.local
MAIL_PRODUCT_NAME=HireWise
OUTBOX_POLL_INTERVAL_MS=5000
OUTBOX_BATCH_SIZE=20
OUTBOX_MAX_ATTEMPTS=5

# --- RBAC cache TTL (giay) ---
RBAC_USER_STATUS_CACHE_TTL_SECONDS=45
RBAC_SESSION_CACHE_TTL_SECONDS=20
RBAC_USER_ROLES_CACHE_TTL_SECONDS=30
RBAC_ROLE_PERMISSION_CACHE_TTL_SECONDS=300

# --- Log level ---
# root: log cua framework/thu vien ben thu 3.
# app: log cua package com.hirewise.be (code cua chinh minh) - thuong de DEBUG o local, INFO o dev/prod de khong qua nhieu.
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG

# --- Cloud Storage OAuth (UC-07/UC-08) ---
# Registered as a "Web application" OAuth client on each provider's developer
# console, with the matching *_REDIRECT_URI below set as an authorized redirect URI.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://localhost:8080/api/integrations/cloud-storage/google-drive/callback
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DROPBOX_REDIRECT_URI=http://localhost:8080/api/integrations/cloud-storage/dropbox/callback
# base64, must decode to exactly 32 bytes (256 bits) - e.g. `openssl rand -base64 32`
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_FRONTEND_REDIRECT_URL=http://localhost:5173/settings/integrations

# --- Background token refresh worker (service.CloudStorageTokenRefreshWorker) ---
# How often (ms) the worker checks whether the current Cloud Storage
# connection's access token needs refreshing. Default 300000 = 5 minutes.
INTEGRATION_TOKEN_REFRESH_POLL_INTERVAL_MS=300000
# How many minutes before token_expires_at the worker refreshes it early.
# Must be >= poll interval above (in minutes) or a token could expire
# between two polls before ever being picked up. Default 15 minutes.
INTEGRATION_TOKEN_REFRESH_BEFORE_EXPIRY_MINUTES=15
