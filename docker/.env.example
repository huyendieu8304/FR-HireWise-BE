# Copy file này thành ".env" (đừng commit ".env" thật lên git) rồi điền
# giá trị Supabase của bạn. Mỗi thành viên trong team dùng CHUNG một
# Supabase project (chung DB) nhưng có thể tự đặt admin password khác
# nhau cho lần bootstrap đầu tiên nếu muốn.

# --- Keycloak bootstrap admin (chỉ áp dụng lần khởi tạo storage đầu tiên) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin

# --- Cổng/hostname Keycloak chạy local (PHẢI giống nhau trên mọi máy) ---
KC_PORT=8443
KC_HOSTNAME=localhost

# --- Thông tin Supabase Postgres ---
# Lấy tại: Supabase Dashboard > Project Settings > Database > Connection info
# Dùng "Direct connection" hoặc "Session pooler" (port 5432) - KHÔNG dùng
# "Transaction pooler" (port 6543).
SUPABASE_DB_HOST=db.xxxxxxxxxxxx.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=keycloak_svc
SUPABASE_DB_PASSWORD=keycloak_service_account

# Schema riêng cho Keycloak trong DB Supabase
KC_DB_SCHEMA=keycloak
